---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');

// Sort chronologically
allArticles.sort((a, b) => new Date(b.data.timestamp).valueOf() - new Date(a.data.timestamp).valueOf());

// Chronological feed of the 3 most recent articles
const currentArticles = allArticles.slice(0, 3);
---

<Layout title="Current">
    <div class="container">
        <h1 style="margin-bottom: 2rem; border-bottom: var(--border-thick); padding-bottom: 0.5rem;">Current Feed</h1>
        <div class="grid">
            {currentArticles.map(article => (
                <ArticleCard 
                    title={article.data.title}
                    url={`${import.meta.env.BASE_URL}/articles/${article.id}`}
                    category={article.data.category}
                    summary={article.data.summary}
                    byline={article.data.author}
                    timestamp={article.data.timestamp}
                />
            ))}
        </div>
    </div>
</Layout>
