---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
    <div class="container">
        <div class="masthead">
            <h1 class="logo"><a href={base}>Ecologica</a></h1>
            <p class="slogan">A Better World Is Possible</p>
            <p class="header-date"><span class="live-caprica-date" style="opacity: 0.5; transition: opacity 0.3s;">Syncing universe clock...</span></p>
        </div>
        <nav class="main-nav">
            <ul>
                <li><a href={base}>Home</a></li>
                <li><a href={`${base}/current`}>Current</a></li>
                <li><a href={`${base}/category/news`}>News</a></li>
                <li><a href={`${base}/category/opinion`}>Opinion</a></li>
                <li><a href={`${base}/category/culture`}>Culture</a></li>
            </ul>
        </nav>
    </div>
</header>
