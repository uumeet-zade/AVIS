---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ecologica - The Official Publication of the Democratic Greens of Caprica" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Ecologica</title>
	</head>
	<body>
		<Header />
		
		<main class="site-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<h2 class="footer-logo">Ecologica</h2>
				<p class="mission">A Better World Is Possible. The Official Publication of the Democratic Greens of Caprica.</p>
				<p class="copyright">&copy; 2026 Ecologica (Caprica Universe Fictional Entity). All rights reserved.</p>
			</div>
		</footer>

		<script>
			// Live Caprica Date Fetcher
			async function fetchCapricaDate() {
				const elements = document.querySelectorAll('.live-caprica-date');
				if (elements.length === 0) return;

				try {
					const response = await fetch('https://caprica.miraheze.org/w/api.php?action=parse&page=Main_Page&prop=text&format=json&origin=*');
					const data = await response.json();
					const htmlString = data.parse.text['*'];
					
					// Create a dummy DOM element to parse the HTML string
					const parser = new DOMParser();
					const doc = parser.parseFromString(htmlString, 'text/html');
					
					// The Caprica wiki usually has something like "Today is: <b>Date</b>"
					// We need to find the text after "Today is:"
					const pageText = doc.body.textContent || "";
					const todayIsMatch = pageText.match(/Today is:\s*(.+?)(?=\n|$)/);
					
					if (todayIsMatch && todayIsMatch[1]) {
						const dateText = todayIsMatch[1].trim();
						elements.forEach(el => {
							el.textContent = dateText;
							(el as HTMLElement).style.opacity = '1';
						});
					} else {
						throw new Error("Date pattern not found on Main Page");
					}
				} catch (error) {
					console.error('Failed to sync universe clock:', error);
					elements.forEach(el => el.textContent = "Date Sync Failed");
				}
			}

			fetchCapricaDate();
		</script>
	</body>
</html>
